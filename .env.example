# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=mydb

# Optional Aiven/MySQL TLS certificate path
# Example: /absolute/path/to/ca.pem
DB_SSL_CA=
DB_SSL_VERIFY=true

# Legacy aliases are still supported by app/config/database.php:
# DB_USER=
# DB_NAME=
